      }
    },
    {
      "id": "bytehum_lac",
      "label": "ByteHum LAC Module\n(Learned Alignment Classifier\nL2 Prototypes on Hypersphere)",
      "kind": "component",
      "properties": {
        "layer": "bytehum"
      }
    },
    {
      "id": "bytehum_grl",
